<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by claude-home/install.sh (@PYTHON@, @BIN@). Nightly ingest at 02:30;
     the job itself skips while xcodebuild runs and below the 10 GB free floor. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.claude.session-analyzer</string>
  <key>ProgramArguments</key>
  <array><string>@PYTHON@</string><string>@BIN@</string><string>nightly</string></array>
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>30</integer></dict>
  <key>ProcessType</key><string>Background</string>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>/dev/null</string>
  <key>StandardErrorPath</key><string>/dev/null</string>
</dict>
</plist>
